{
  "name": "virna-website",
  "version": "1.0.0",
  "private": true,
  "description": "Virna storefront - Express + SQLite backend with a vanilla JS frontend",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
