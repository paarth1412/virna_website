# Copy to .env and fill in. Never commit .env.
PORT=4390
NODE_ENV=development
# Database. Locally, a SQLite file is used (DATABASE_PATH, default ./data/virna.db).
# In production, use a hosted Turso database so data survives server restarts:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin accounts — created on first start. Passwords are hashed in the database;
# changing them here later does NOT change an existing account's password.
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Google sign-in: Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID (Web application). Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Razorpay: Dashboard → Account & Settings → API Keys. Leave empty to simulate
# online payments locally (production falls back to cash on delivery only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
